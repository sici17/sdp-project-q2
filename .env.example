# Copy this file to .env for local overrides. Never commit real credentials.
#
# Compose resolves its env file relative to the Compose file's own directory,
# so this one only takes effect when it is named explicitly:
#
#   docker compose -f infrastructure/docker-compose.yml --env-file .env up
#
# Run from the repository root. The helper scripts under scripts/ pass the
# flag for you.

# Public browser origin. The frontend proxies API/manual traffic to the gateway.
PUBLIC_ORIGIN=http://localhost:5173
FRONTEND_BIND_ADDRESS=0.0.0.0

# Replace every local-only value before sharing a deployment.
AI_SERVICE_SHARED_SECRET=replace-with-a-random-secret
GATEWAY_CSRF_SECRET=replace-with-a-different-random-secret
MCP_SHARED_SECRET=replace-with-another-random-secret

# Local controlled-MVP defaults. Demo auth is intentionally restricted to the
# listed machine and an operator role; use OIDC outside a controlled demo LAN.
GATEWAY_AUTH_MODE=demo
GATEWAY_MACHINE_IDS=MCH-0001,MCH-0002,MCH-0003,MCH-0004,MCH-0005,MCH-0006,MCH-0007,MCH-0008
GATEWAY_AUTH_COOKIE_NAME=arol_q2_demo_access
GATEWAY_AUTH_COOKIE_SECURE=false
GATEWAY_AUTH_DEMO_ROLES=operator

# The demo default: the model writes the answer. Set LLM_PROVIDER=deterministic
# for a fast, model-free run - the composer's draft is grounded either way, so
# this changes the prose and not what the answer claims. See
# docs/evaluation/llm-model-comparison.md for what each costs.
LLM_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct

# Optional Azure OpenAI provider settings. Put real secrets in the deployment
# platform's secret manager rather than committing them to this file.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional OIDC deployment settings.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/api/v1/auth/post-logout-callback
OIDC_REQUEST_TIMEOUT_MS=5000

